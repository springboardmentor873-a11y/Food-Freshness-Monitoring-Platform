# General Settings
APP_NAME=AI Food Freshness Monitoring API
APP_VERSION=1.0.0
API_PREFIX=/api/v1

# Security & JWT
JWT_SECRET_KEY=change_this_to_a_secure_32_character_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Model & Upload Configuration
MODEL_PATH=app/models/efficientnetb0.keras
UPLOAD_FOLDER=app/uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=food_freshness

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173
